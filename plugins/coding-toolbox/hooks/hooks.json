{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/encoding-guard.mjs",
            "statusMessage": "Checking file encoding"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:coding-toolbox:coding-toolbox-hooks",
            "tool": "reroute_explore"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/npm-ci-on-worktree.mjs",
            "timeout": 300,
            "async": true
          },
          {
            "type": "mcp_tool",
            "server": "plugin:coding-toolbox:coding-toolbox-hooks",
            "tool": "worktree_refresh",
            "statusMessage": "Refreshing new worktree from origin"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:coding-toolbox:coding-toolbox-hooks",
            "tool": "interaction_gate"
          }
        ]
      }
    ]
  }
}
