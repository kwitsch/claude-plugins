{
  "modules": [
    "./register.js"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "universal-lint: reading the file watch list",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/watch-paths.mjs"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "universal-lint: updating the file watch list",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/watch-paths.mjs"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "statusMessage": "universal-lint: collecting lint reports",
            "server": "plugin:universal-lint:lint",
            "tool": "prompt_submitted",
            "timeout": 10,
            "input": {
              "cwd": "${cwd}",
              "session_id": "${session_id}",
              "scratchpad_dir": "${scratchpad_dir}"
            }
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "statusMessage": "universal-lint: linting the changed file",
            "server": "plugin:universal-lint:lint",
            "tool": "file_changed",
            "timeout": 100,
            "input": {
              "cwd": "${cwd}",
              "session_id": "${session_id}",
              "scratchpad_dir": "${scratchpad_dir}",
              "file_path": "${file_path}",
              "event": "${event}"
            }
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "statusMessage": "universal-lint: linting this turn's edits",
            "server": "plugin:universal-lint:lint",
            "tool": "stop",
            "timeout": 100,
            "input": {
              "hook_event_name": "${hook_event_name}",
              "cwd": "${cwd}",
              "session_id": "${session_id}",
              "agent_id": "${agent_id}",
              "scratchpad_dir": "${scratchpad_dir}",
              "stop_hook_active": "${stop_hook_active}"
            }
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "statusMessage": "universal-lint: linting the subagent's edits",
            "server": "plugin:universal-lint:lint",
            "tool": "stop",
            "timeout": 100,
            "input": {
              "hook_event_name": "${hook_event_name}",
              "cwd": "${cwd}",
              "session_id": "${session_id}",
              "agent_id": "${agent_id}",
              "scratchpad_dir": "${scratchpad_dir}",
              "stop_hook_active": "${stop_hook_active}"
            }
          }
        ]
      }
    ]
  }
}
