#!/usr/bin/env bash
# git-shim/git — a read-only git facade placed first on PATH for the copilot
# review run only.
#
# Copilot approves shell commands on a per-git-subcommand basis, so its
# --allow-tool list cannot express "git diff but NOT git diff --output". The
# read-only subcommands diff/log/show accept --output=<path> and write an
# arbitrary file, and git grep -O spawns a pager command — both verified
# against Copilot CLI 1.0.60 (git diff --output even wrote outside the CWD,
# and --deny-tool write does not cover shell side effects). Write *subcommands*
# (commit, branch, …) are already blocked by the allowlist; this facade closes
# the residual file-writing/command-spawning *flag* vector so the review run
# is genuinely read-only, the way codex gets via --sandbox read-only.
#
# It forwards every invocation to the real git (COPILOT_REVIEW_REAL_GIT, set by
# copilot-review.sh before the shim dir is prepended to PATH) except those
# carrying such a flag, which it refuses with exit 13.
set -u

real="${COPILOT_REVIEW_REAL_GIT:-}"
if [ -z "$real" ]; then
  echo "git-shim: COPILOT_REVIEW_REAL_GIT is unset — refusing to run" >&2
  exit 127
fi

for arg in "$@"; do
  case "$arg" in
    -o | --output | --output=* | \
    --output-directory | --output-directory=* | \
    -O | -O*)
      echo "git-shim: refusing file-writing/pager-exec flag '$arg'" >&2
      exit 13
      ;;
  esac
done

exec "$real" "$@"
