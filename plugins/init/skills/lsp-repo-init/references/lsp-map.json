{
  ".js":    { "server": "vtsls", "command": "npx", "args": ["-y", "@vtsls/language-server@0.3.0", "--stdio"], "extensionToLanguage": { ".js": "javascript", ".cjs": "javascript", ".mjs": "javascript", ".jsx": "javascriptreact", ".ts": "typescript", ".cts": "typescript", ".mts": "typescript", ".tsx": "typescriptreact" }, "startupTimeout": 60000 },
  ".cjs":   "vtsls",
  ".mjs":   "vtsls",
  ".jsx":   "vtsls",
  ".ts":    "vtsls",
  ".cts":   "vtsls",
  ".mts":   "vtsls",
  ".tsx":   "vtsls",
  ".sh":    { "server": "bashls", "command": "npx", "args": ["-y", "bash-language-server@5.6.0", "start"], "extensionToLanguage": { ".sh": "shellscript", ".bash": "shellscript" }, "startupTimeout": 60000 },
  ".bash":  "bashls",
  ".py":    { "server": "pylsp", "command": "pylsp", "args": [], "extensionToLanguage": { ".py": "python" }, "startupTimeout": 60000, "note": "Requires: pip install python-lsp-server" },
  ".go":    { "server": "gopls", "command": "gopls", "args": [], "extensionToLanguage": { ".go": "go" }, "startupTimeout": 60000, "note": "Requires: go install golang.org/x/tools/gopls@latest" },
  ".rs":    { "server": "rust-analyzer", "command": "rust-analyzer", "args": [], "extensionToLanguage": { ".rs": "rust" }, "startupTimeout": 60000, "note": "Requires: native rust-analyzer installation (rustup component add rust-analyzer)" },
  ".json":  { "server": "jsonls", "command": "npx", "args": ["-y", "-p", "vscode-langservers-extracted@4.10.0", "vscode-json-languageserver", "--stdio"], "extensionToLanguage": { ".json": "json", ".jsonc": "jsonc" }, "startupTimeout": 60000 },
  ".jsonc": "jsonls",
  ".css":   { "server": "cssls", "command": "npx", "args": ["-y", "-p", "vscode-langservers-extracted@4.10.0", "vscode-css-languageserver", "--stdio"], "extensionToLanguage": { ".css": "css", ".scss": "scss", ".less": "less" }, "startupTimeout": 60000 },
  ".scss":  "cssls",
  ".less":  "cssls",
  ".html":  { "server": "htmlls", "command": "npx", "args": ["-y", "-p", "vscode-langservers-extracted@4.10.0", "vscode-html-languageserver", "--stdio"], "extensionToLanguage": { ".html": "html" }, "startupTimeout": 60000 },
  ".lua":   { "server": "lua-language-server", "command": "lua-language-server", "args": [], "extensionToLanguage": { ".lua": "lua" }, "startupTimeout": 60000, "note": "Requires: native lua-language-server installation" },
  ".yaml":  { "server": "yamlls", "command": "npx", "args": ["-y", "yaml-language-server@1.15.0", "--stdio"], "extensionToLanguage": { ".yaml": "yaml", ".yml": "yaml" }, "startupTimeout": 60000 },
  ".yml":   "yamlls"
}
