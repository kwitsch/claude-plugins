{
  "modules": ["./notice.mjs"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:dprint:dprint-hooks",
            "tool": "format_pre",
            "timeout": 60,
            "input": {
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "session_id": "${session_id}",
              "scratchpad_dir": "${scratchpad_dir}",
              "tool_name": "${tool_name}",
              "tool_input": {
                "file_path": "${tool_input.file_path}",
                "content": "${tool_input.content}",
                "old_string": "${tool_input.old_string}",
                "new_string": "${tool_input.new_string}",
                "replace_all": "${tool_input.replace_all}"
              }
            }
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:dprint:dprint-hooks",
            "tool": "bash_started",
            "timeout": 10,
            "input": {
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "session_id": "${session_id}",
              "scratchpad_dir": "${scratchpad_dir}",
              "tool_use_id": "${tool_use_id}"
            }
          }
        ]
      },
      {
        "matcher": "Edit|Write|Read|Bash|MultiEdit",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:dprint:dprint-hooks",
            "tool": "drain_notices",
            "timeout": 10,
            "input": {
              "hook_event_name": "${hook_event_name}",
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "session_id": "${session_id}"
            }
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:dprint:dprint-hooks",
            "tool": "worktree_entered",
            "timeout": 60,
            "input": {
              "agent_id": "${agent_id}",
              "session_id": "${session_id}",
              "tool_response": { "worktreePath": "${tool_response.worktreePath}" }
            }
          }
        ]
      },
      {
        "matcher": "ExitWorktree",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:dprint:dprint-hooks",
            "tool": "worktree_exited",
            "timeout": 60,
            "input": {
              "agent_id": "${agent_id}",
              "session_id": "${session_id}",
              "tool_response": { "restoredCwd": "${tool_response.restoredCwd}" }
            }
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:dprint:dprint-hooks",
            "tool": "file_written",
            "timeout": 60,
            "input": {
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "session_id": "${session_id}",
              "scratchpad_dir": "${scratchpad_dir}",
              "tool_input": { "file_path": "${tool_input.file_path}" }
            }
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:dprint:dprint-hooks",
            "tool": "bash_finished",
            "timeout": 30,
            "input": {
              "hook_event_name": "${hook_event_name}",
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "session_id": "${session_id}",
              "scratchpad_dir": "${scratchpad_dir}",
              "tool_use_id": "${tool_use_id}"
            }
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:dprint:dprint-hooks",
            "tool": "bash_finished",
            "timeout": 30,
            "input": {
              "hook_event_name": "${hook_event_name}",
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "session_id": "${session_id}",
              "scratchpad_dir": "${scratchpad_dir}",
              "tool_use_id": "${tool_use_id}"
            }
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:dprint:dprint-hooks",
            "tool": "cwd_changed",
            "timeout": 60,
            "input": {
              "agent_id": "${agent_id}",
              "session_id": "${session_id}",
              "new_cwd": "${new_cwd}"
            }
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/mcp/watch-paths.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:dprint:dprint-hooks",
            "tool": "file_changed",
            "timeout": 60,
            "input": {
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "session_id": "${session_id}",
              "scratchpad_dir": "${scratchpad_dir}",
              "file_path": "${file_path}",
              "event": "${event}"
            }
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/mcp/watch-paths.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:dprint:dprint-hooks",
            "tool": "drain_notices",
            "timeout": 10,
            "input": {
              "hook_event_name": "${hook_event_name}",
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "session_id": "${session_id}"
            }
          }
        ]
      }
    ]
  }
}
