{
  "description": "PreToolUse Bash -> rtk-rewrite.mjs: rewrites Bash commands to rtk equivalents using the bundled rtk binary. SessionStart -> server.mjs --session-start-hook (command hook: mcp_tool hard-errors pre-connect), SubagentStart -> hook_subagent_context, PreToolUse Grep|Glob -> hook_symbol_context, PostToolUse Read -> hook_coverage_context: fail-open, context-only codebase-memory-mcp graph context served as mcp_tool hooks by this plugin's own codebase-memory proxy MCP server (mcp/server.mjs).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/mcp/server.mjs",
            "args": ["--session-start-hook"],
            "timeout": 20,
            "statusMessage": "Checking codebase graph..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:linux-token-efficiency:codebase-memory",
            "tool": "hook_subagent_context",
            "timeout": 20,
            "input": { "cwd": "${cwd}" }
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/rtk-rewrite.mjs",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Grep|Glob",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:linux-token-efficiency:codebase-memory",
            "tool": "hook_symbol_context",
            "timeout": 20,
            "input": {
              "cwd": "${cwd}",
              "tool_name": "${tool_name}",
              "tool_input": { "pattern": "${tool_input.pattern}" }
            }
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:linux-token-efficiency:codebase-memory",
            "tool": "hook_coverage_context",
            "timeout": 20,
            "input": {
              "cwd": "${cwd}",
              "tool_input": { "file_path": "${tool_input.file_path}" }
            }
          }
        ]
      }
    ]
  }
}
