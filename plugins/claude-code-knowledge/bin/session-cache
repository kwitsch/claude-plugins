#!/usr/bin/env sh
# session-cache — SessionStart hook (command type; mcp_tool is unreliable at
# SessionStart). Manages a per-Claude-Code-version doc cache under
# ${CLAUDE_PLUGIN_DATA}:
#   1) purge cache-<other-version> dirs,
#   2) ensure cache-<current-version> exists,
#   3) announce the path + version via additionalContext.
# stdout = hook JSON only; diagnostics -> stderr. NEVER rm with an empty base.

# PATH-harden: non-interactive spawns may not load user bin dirs where `claude`
# lives. $HOME quoted so it is not left literal.
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"

emit() {
  # $1 = additionalContext string
  jq -nc --arg ctx "$1" '{
    hookSpecificOutput: {
      hookEventName: "SessionStart",
      additionalContext: $ctx
    }
  }'
}

# Fail open: emit() and version detection both need jq. Without it, do nothing
# (never block a session, never emit broken output). Matches redirect-guide.
command -v jq >/dev/null 2>&1 || exit 0

# Hard guard: without a base dir we must never run any rm.
if [ -z "${CLAUDE_PLUGIN_DATA:-}" ]; then
  emit "claude-code-knowledge: plugin data dir unavailable; doc cache disabled this session. Use the /cck-* skills and the cc-knowledge agent; treat training knowledge about Claude Code as stale."
  exit 0
fi

# Resolve the running Claude Code version. The regex extracts and sanitizes to
# digits/dots; unresolvable -> sentinel "unknown" (fail-open).
V=$(claude --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n1)
[ -z "$V" ] && V=unknown

cache_dir="$CLAUDE_PLUGIN_DATA/cache-$V"

# Purge stale caches (destructive — written defensively): only cache-* entries
# under the guarded base, skip symlinks, keep the current version.
for d in "$CLAUDE_PLUGIN_DATA"/cache-*; do
  [ -e "$d" ] || continue          # literal glob when nothing matches
  [ -L "$d" ] && continue          # never follow/delete symlinks
  [ -d "$d" ] || continue
  [ "$(basename "$d")" = "cache-$V" ] && continue
  rm -rf -- "$d"
done

mkdir -p "$cache_dir"

emit "claude-code-knowledge: Claude Code version $V. Live-docs cache at $cache_dir (cache-<version> dirs; stale versions purged each session). When authoring or validating Claude Code skills, agents, rules, or hooks, use the /cck-* skills and the cc-knowledge agent (it reads this cache and fetches code.claude.com/docs on miss). Treat training knowledge about Claude Code as stale."
exit 0
