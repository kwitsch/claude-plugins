{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/npm-ci-on-worktree.mjs",
            "timeout": 300,
            "async": true
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/npm-install-on-package-change.mjs",
            "timeout": 300,
            "async": true
          }
        ]
      }
    ]
  }
}
