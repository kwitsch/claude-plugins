{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/sessionresume.mjs"
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/sessionstartup.mjs"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/SessionStart.md"]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:cave-context:cave-context",
            "tool": "hook_userpromptsubmit"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|WebFetch|Agent|mcp__plugin_cave-context_cave-context__ctx_execute|mcp__plugin_cave-context_cave-context__ctx_execute_file|mcp__plugin_cave-context_cave-context__ctx_batch_execute",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:cave-context:cave-context",
            "tool": "hook_pretooluse"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read|Write|Edit|NotebookEdit|Glob|Grep|Task|Agent|mcp__plugin_cave-context_cave-context__ctx_",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:cave-context:cave-context",
            "tool": "hook_posttooluse"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:cave-context:cave-context",
            "tool": "hook_precompact"
          }
        ]
      }
    ]
  }
}
