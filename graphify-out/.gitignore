# Machine-local graphify state — never commit.
# Committable artifacts: graph.json, GRAPH_REPORT.md (agent-consumed).
# graph.html is human-only — graphify here serves agents, keep it local.

# Interpreter/root pointers (absolute machine paths)
.graphify_python
.graphify_root

# Runtime/temp state (.graphify_detect.json, .graphify_chunk_*.json, labels, …)
.graphify_*

# Extraction cache (machine-local, regenerated on demand)
cache/

# Incremental-update manifest (absolute paths + mtimes, machine-specific)
manifest.json

# Local token cost tracker
cost.json

# Date-named backup folders created by `graphify update`
[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# Human-only browser visualization (regenerated locally by `graphify update`)
graph.html
