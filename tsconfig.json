{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "lib": ["ES2022"]
  },
  "include": [
    "plugins/**/*.mjs",
    "test/**/*.mjs"
  ],
  "exclude": [
    "node_modules"
  ]
}
