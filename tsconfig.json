{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2022"]
  },
  "include": ["plugins/**/*.mjs", "test/**/*.mjs", "src/**/*.ts", "src/**/*.mjs", "types/**/*.d.ts"],
  "exclude": ["node_modules"]
}
